      }
    },
    {
      "id": "energy",
      "file": "energy.mp3",
      "hash": "0f4aaad5a474",
      "durationSec": 41.797,
      "cues": [
        {
          "text": "Hiệp bốn: xăng và điện.",
          "start": 0.0,
          "end": 2.164
        },
        {
          "text": "Tháng Chín năm 2026,",
          "start": 2.164,
          "end": 5.066
        },
        {
          "text": "giá xăng trung bình ở California là khoảng 6,24 đô một gallon, cao nhất nước Mỹ.",
          "start": 5.066,
          "end": 11.299
        },
        {
          "text": "Ở Texas, khoảng 3,96 đô.",
          "start": 11.299,
          "end": 14.826
        },
        {
          "text": "Đổ bốn mươi gallon một tháng, người ở California trả nhiều hơn khoảng 90 đô.",
          "start": 14.826,
          "end": 20.38
        },
        {
          "text": "Giá điện ở California cũng gấp đôi Texas.",
          "start": 20.38,
          "end": 24.219
        },
        {
          "text": "Cùng một mức dùng điện, hóa đơn ở California có thể lên khoảng 300 đô,",
          "start": 24.219,
          "end": 29.344
        },
        {
          "text": "còn ở Texas khoảng 150 đô.",
          "start": 29.344,
          "end": 32.969
        },
        {
          "text": "Nhưng mùa hè Texas rất nóng, máy lạnh chạy gần như cả ngày,",
          "start": 32.969,
          "end": 37.148
        },
        {
          "text": "nên khoảng cách thực tế hẹp hơn.",
          "start": 37.148,
          "end": 39.119
        },
        {
          "text": "Hiệp bốn: Texas thắng.",
          "start": 39.119,
          "end": 41.791
        }
      ],
      "markers": {
        "gas": 2.164,
        "gasm": 14.826,
        "elec": 20.38,
        "heat": 32.969,
        "win": 39.119
      }
    },
    {
      "id": "income",
      "file": "income.mp3",
      "hash": "5ae68df5eb87",
      "durationSec": 34.178,
      "cues": [
        {
          "text": "Đến đây, Texas đang dẫn bốn không.",
          "start": 0.0,
          "end": 2.369
        },
        {
          "text": "Nhưng hiệp cuối có thể lật ngược tất cả: tiền lương.",
          "start": 2.369,
          "end": 6.036
        },
        {
          "text": "Thu nhập trung vị của một hộ gia đình ở California là khoảng 100.000 đô một năm.",
          "start": 6.036,
          "end": 11.929
        },
        {
          "text": "Ở Texas, khoảng 77.500 đô.",
          "start": 11.929,
          "end": 14.571
        },
        {
          "text": "Chênh lệch hơn 22.000 đô mỗi năm.",
          "start": 14.571,
          "end": 17.42
        },
        {
          "text": "Nhiều ngành như công nghệ, y tế hay kỹ thuật trả lương ở California cao hơn hẳn,",
          "start": 17.42,
          "end": 23.527
        },
        {
          "text": "đủ để bù cho chi phí đắt đỏ.",
          "start": 23.527,
          "end": 25.36
        },
        {
          "text": "Nhưng lợi thế này chỉ đến với bạn nếu chính nghề của bạn được trả cao ở California.",
          "start": 25.36,
          "end": 30.97
        },
        {
          "text": "Hiệp năm: California thắng.",
          "start": 30.97,
          "end": 34.17
        }
      ],
      "markers": {
        "med": 6.036,
        "gap": 14.571,
        "why": 17.42,
        "but": 25.36,
        "win": 30.97
      }
    },
    {
      "id": "score",
      "file": "score.mp3",
      "hash": "7a373fb02626",
      "durationSec": 27.297,
      "cues": [
        {
          "text": "Vậy kết quả cuối cùng là gì?",
          "start": 0.0,
          "end": 1.5
        },
        {
          "text": "Texas thắng bốn hiệp, California thắng một.",
          "start": 1.5,
          "end": 5.062
        },
        {
          "text": "Với một người độc thân, như chúng ta đã tính ở tập một,",
          "start": 5.062,
          "end": 8.486
        },
        {
          "text": "sống ở Houston tốn khoảng 3.000 đô mỗi tháng, còn ở Quận Cam khoảng 4.600 đô.",
          "start": 8.486,
          "end": 14.536
        },
        {
          "text": "Với một gia đình bốn người, hai vợ chồng cùng đi làm,",
          "start": 14.536,
          "end": 17.929
        },
        {
          "text": "theo MIT, ở Houston cần thu nhập khoảng 102.000 đô một năm.",
          "start": 17.929,
          "end": 23.357
        },
        {
          "text": "Ở Quận Cam, con số này lên tới khoảng 164.000 đô.",
          "start": 23.357,
          "end": 27.286
        }
      ],
      "markers": {
        "tally": 1.5,
        "single": 5.062,
        "family": 14.536
      }
    },
    {
      "id": "verdict",
      "file": "verdict.mp3",
      "hash": "b741b46c2d42",
      "durationSec": 42.331,
      "cues": [
        {
          "text": "Vậy nên chuyển sang Texas không?",
          "start": 0.0,
          "end": 1.625
        },
        {
          "text": "Nếu bạn có thu nhập trung bình, muốn mua nhà và nuôi con:",
          "start": 1.625,
          "end": 5.203
        },
        {
          "text": "Texas gần như chắc chắn giúp bạn tiết kiệm hơn.",
          "start": 5.203,
          "end": 7.857
        },
        {
          "text": "Nếu bạn làm trong ngành trả lương cao ở California,",
          "start": 7.857,
          "end": 10.814
        },
        {
          "text": "hoặc đã có nhà từ lâu với thuế nhà đất thấp: ở lại California có thể vẫn có lợi.",
          "start": 10.814,
          "end": 16.429
        },
        {
          "text": "Và đừng quên những thứ không có trên bảng tính: thời tiết,",
          "start": 16.429,
          "end": 20.196
        },
        {
          "text": "gia đình, cộng đồng người Việt và cơ hội việc làm cho chính bạn.",
          "start": 20.196,
          "end": 24.321
        },
        {
          "text": "Rẻ hơn không tự động có nghĩa là tiết kiệm hơn.",
          "start": 24.321,
          "end": 27.129
        },
        {
          "text": "Điều quan trọng là bạn giữ lại được bao nhiêu sau khi trả hết mọi chi phí.",
          "start": 27.129,
          "end": 31.92
        },
        {
          "text": "Còn bạn, nếu được chọn, bạn sẽ sống ở California hay Texas?",
          "start": 31.92,
          "end": 36.349
        },
        {
          "text": "Hãy chia sẻ lý do ở phần bình luận.",
          "start": 36.349,
          "end": 38.694
        },
        {
          "text": "Và đừng quên đăng ký kênh Tin Nước Mỹ để xem những tập tiếp theo.",
          "start": 38.694,
          "end": 42.313
        }
      ],
      "markers": {
