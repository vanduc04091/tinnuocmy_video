{
  "slug": "california-vs-texas",
  "voice": "vi-VN-NamMinhNeural",
  "rate": "-4%",
  "scenes": [
    {
      "id": "hook",
      "file": "hook.mp3",
      "hash": "4c5986315202",
      "durationSec": 36.091,
      "cues": [
        {
          "text": "California hay Texas?",
          "start": 0.0,
          "end": 1.75
        },
        {
          "text": "Đây là hai bang có nhiều người Việt nhất nước Mỹ.",
          "start": 1.75,
          "end": 4.464
        },
        {
          "text": "Khoảng một phần ba người Mỹ gốc Việt sống ở California, và Texas đứng thứ hai.",
          "start": 4.464,
          "end": 9.563
        },
        {
          "text": "Nhiều năm qua, rất nhiều gia đình đã rời California để chuyển sang Texas,",
          "start": 9.563,
          "end": 14.313
        },
        {
          "text": "với một lý do quen thuộc: sống ở Texas rẻ hơn.",
          "start": 14.313,
          "end": 17.837
        },
        {
          "text": "Nhưng rẻ hơn có thật sự là tiết kiệm hơn?",
          "start": 17.837,
          "end": 21.42
        },
        {
          "text": "Hôm nay, chúng ta sẽ cho hai bang đối đầu qua năm hiệp: thuế thu nhập,",
          "start": 21.42,
          "end": 26.499
        },
        {
          "text": "thuế mua sắm, nhà ở, xăng và điện, và cuối cùng là tiền lương.",
          "start": 26.499,
          "end": 31.727
        },
        {
          "text": "Bên nào thắng, hãy cùng Tin Nước Mỹ xem những con số thực tế.",
          "start": 31.727,
          "end": 36.084
        }
      ],
      "markers": {
        "vn": 1.75,
        "move": 9.563,
        "q": 17.837,
        "plan": 21.42,
        "r1": 24.913,
        "r2": 26.499,
        "r3": 27.652,
        "r4": 28.37,
        "r5": 29.656,
        "go": 31.727
      }
    },
    {
      "id": "income-tax",
      "file": "income-tax.mp3",
      "hash": "a832a184bc07",
      "durationSec": 31.431,
      "cues": [
        {
          "text": "Hiệp một: thuế thu nhập.",
          "start": 0.0,
          "end": 1.631
        },
        {
          "text": "Texas không thu thuế thu nhập tiểu bang.",
          "start": 1.631,
          "end": 4.238
        },
        {
          "text": "Không một đồng nào.",
          "start": 4.238,
          "end": 5.597
        },
        {
          "text": "California thì thu theo bậc, từ một đến mười ba phần trăm, cao nhất nước Mỹ.",
          "start": 5.597,
          "end": 10.786
        },
        {
          "text": "Với mức lương 4.000 đô một tháng như tập trước,",
          "start": 10.786,
          "end": 13.964
        },
        {
          "text": "người ở Texas thực nhận khoảng 3.400 đô, còn ở California khoảng 3.260 đô.",
          "start": 13.964,
          "end": 20.953
        },
        {
          "text": "Chênh lệch khoảng 130 đô mỗi tháng, tức gần 1.600 đô một năm.",
          "start": 20.953,
          "end": 26.214
        },
        {
          "text": "Lương càng cao, khoảng cách này càng lớn.",
          "start": 26.214,
          "end": 29.186
        },
        {
          "text": "Hiệp một: Texas thắng.",
          "start": 29.186,
          "end": 31.429
        }
      ],
      "markers": {
        "tx": 1.631,
        "ca": 5.597,
        "ex": 10.786,
        "diff": 20.953,
        "high": 26.214,
        "win": 29.186
      }
    },
    {
      "id": "sales-tax",
      "file": "sales-tax.mp3",
      "hash": "f30dd5a959b4",
      "durationSec": 24.527,
      "cues": [
        {
          "text": "Hiệp hai: thuế mua sắm, loại thuế cộng thêm khi bạn thanh toán ở quầy.",
          "start": 0.0,
          "end": 4.42
        },
        {
          "text": "Ở California, mức trung bình cả thuế tiểu bang và địa phương là khoảng chín phần trăm.",
          "start": 4.42,
          "end": 9.92
        },
        {
          "text": "Ở Texas, khoảng tám phẩy hai phần trăm.",
          "start": 9.92,
          "end": 12.697
        },
        {
          "text": "Mua một chiếc tivi 1.000 đô, bạn trả thêm khoảng 90 đô ở California và 82 đô ở Texas.",
          "start": 12.697,
          "end": 19.972
        },
        {
          "text": "Chênh lệch không lớn.",
          "start": 19.972,
          "end": 21.533
        },
        {
          "text": "Hiệp hai: Texas thắng sát nút.",
          "start": 21.533,
          "end": 24.519
        }
      ],
      "markers": {
        "ca": 4.42,
        "tx": 9.92,
        "ex": 12.697,
        "win": 19.972
      }
    },
    {
      "id": "housing",
      "file": "housing.mp3",
      "hash": "4ed6bfd16bdb",
      "durationSec": 63.728,
      "cues": [
        {
          "text": "Hiệp ba, và đây là hiệp quyết định: nhà ở.",
          "start": 0.0,
          "end": 3.518
        },
        {
          "text": "Giá nhà trung vị ở California năm 2026 là khoảng 888.000 đô.",
          "start": 3.518,
          "end": 10.607
        },
        {
          "text": "Ở Texas, khoảng 330.000 đô.",
          "start": 10.607,
          "end": 13.768
        },
        {
          "text": "Nghĩa là với cùng số tiền,",
          "start": 13.768,
          "end": 16.107
        },
        {
          "text": "bạn mua được gần ba căn nhà ở Texas cho mỗi căn ở California.",
          "start": 16.107,
          "end": 20.524
        },
        {
          "text": "Tiền thuê cũng vậy: căn một phòng ngủ ở Quận Cam đắt hơn gấp đôi ở Houston.",
          "start": 20.524,
          "end": 26.417
        },
        {
          "text": "Nhưng Texas có một cái bẫy: thuế nhà đất.",
          "start": 26.417,
          "end": 30.679
        },
        {
          "text": "Texas thu khoảng một phẩy sáu phần trăm giá trị nhà mỗi năm,",
          "start": 30.679,
          "end": 34.268
        },
        {
          "text": "gấp đôi mức khoảng không phẩy bảy phần trăm của California.",
          "start": 34.268,
          "end": 38.839
        },
        {
          "text": "Dù vậy, vì nhà ở Texas rẻ hơn rất nhiều, tiền thuế nhà đất mỗi tháng vẫn thấp hơn:",
          "start": 38.839,
          "end": 44.612
        },
        {
          "text": "khoảng 440 đô, so với khoảng 520 đô ở California.",
          "start": 44.612,
          "end": 50.762
        },
        {
          "text": "Thêm một lưu ý: bảo hiểm nhà ở Texas đắt vì bão và mưa đá,",
          "start": 50.762,
          "end": 56.357
        },
        {
          "text": "còn ở California, nhiều vùng khó mua bảo hiểm vì cháy rừng.",
          "start": 56.357,
          "end": 60.586
        },
        {
          "text": "Hiệp ba: Texas thắng đậm.",
          "start": 60.586,
          "end": 63.714
        }
      ],
      "markers": {
        "buy": 3.518,
        "tx": 10.607,
        "ratio": 13.768,
        "rent": 20.524,
        "but": 26.417,
        "ptax": 30.679,
