        "income": 40.903
      }
    },
    {
      "id": "tips",
      "file": "tips.mp3",
      "hash": "fc8215074619",
      "durationSec": 49.282,
      "cues": [
        {
          "text": "Vậy làm sao để nuôi xe nhẹ nhàng hơn?",
          "start": 0.0,
          "end": 2.598
        },
        {
          "text": "Một: quy tắc hai mươi, bốn, mười.",
          "start": 2.598,
          "end": 5.262
        },
        {
          "text": "Trả trước ít nhất 20%, vay không quá bốn năm,",
          "start": 5.262,
          "end": 9.0
        },
        {
          "text": "và tổng chi phí xe không quá 10% thu nhập.",
          "start": 9.0,
          "end": 11.964
        },
        {
          "text": "Hai: cân nhắc xe đã qua sử dụng hai, ba năm tuổi,",
          "start": 11.964,
          "end": 16.214
        },
        {
          "text": "vì người chủ đầu tiên đã gánh phần mất giá nặng nhất.",
          "start": 16.214,
          "end": 18.929
        },
        {
          "text": "Ba: xây dựng điểm tín dụng trước khi vay,",
          "start": 18.929,
          "end": 21.953
        },
        {
          "text": "và so sánh lãi suất ở ngân hàng hoặc hiệp hội tín dụng trước khi bước vào đại lý.",
          "start": 21.953,
          "end": 26.349
        },
        {
          "text": "Bốn: so sánh báo giá bảo hiểm mỗi năm.",
          "start": 26.349,
          "end": 29.403
        },
        {
          "text": "Năm: chọn xe tiết kiệm nhiên liệu.",
          "start": 29.403,
          "end": 32.706
        },
        {
          "text": "Theo AAA năm nay, sedan hybrid cỡ trung có chi phí sở hữu thấp nhất,",
          "start": 32.706,
          "end": 37.89
        },
        {
          "text": "khoảng 10.200 đô một năm.",
          "start": 37.89,
          "end": 39.992
        },
        {
          "text": "Và nếu bạn mới sang:",
          "start": 39.992,
          "end": 41.82
        },
        {
          "text": "bằng lái Việt Nam không đổi trực tiếp được ở Texas hay California,",
          "start": 41.82,
          "end": 46.188
        },
        {
          "text": "bạn cần thi lý thuyết và thi lái để có bằng của tiểu bang.",
          "start": 46.188,
          "end": 49.278
        }
      ],
      "markers": {
        "t1": 2.598,
        "t2": 11.964,
        "t3": 18.929,
        "t4": 26.349,
        "t5": 29.403,
