      }
    },
    {
      "id": "outro",
      "file": "outro.mp3",
      "hash": "a5557e0e71bc",
      "durationSec": 18.395,
      "cues": [
        {
          "text": "Tóm lại, giá mua chỉ là phần nổi của tảng băng.",
          "start": 0.0,
          "end": 2.929
        },
        {
          "text": "Mỗi năm, nuôi một chiếc xe mới tốn khoảng một phần tư giá trị chiếc xe đó.",
          "start": 2.929,
          "end": 7.634
        },
        {
          "text": "Còn bạn, chiếc xe của bạn tốn bao nhiêu mỗi tháng, và bạn chọn xe mới hay xe cũ?",
          "start": 7.634,
          "end": 13.044
        },
        {
          "text": "Hãy chia sẻ ở phần bình luận.",
          "start": 13.044,
          "end": 15.134
        },
        {
          "text": "Đừng quên đăng ký kênh Tin Nước Mỹ để xem những tập tiếp theo.",
          "start": 15.134,
          "end": 18.384
        }
      ],
      "markers": {
        "key": 2.929,
        "q": 7.634,
        "sub": 15.134
      }
    }
  ]
}