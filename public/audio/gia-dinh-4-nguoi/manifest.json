    {
      "id": "oc",
      "file": "oc.mp3",
      "hash": "952642e531da",
      "durationSec": 14.719,
      "cues": [
        {
          "text": "Còn nếu gia đình này sống ở Quận Cam, California?",
          "start": 0.0,
          "end": 2.971
        },
        {
          "text": "Theo MIT, họ cần thu nhập khoảng 164.000 đô một năm trước thuế,",
          "start": 2.971,
          "end": 8.25
        },
        {
          "text": "tức hơn 13.000 đô mỗi tháng.",
          "start": 8.25,
          "end": 10.762
        },
        {
          "text": "Tiền nhà và tiền giữ trẻ ở đây đều cao hơn Houston rất nhiều.",
          "start": 10.762,
          "end": 14.714
        }
      ],
      "markers": {
        "need": 2.971,
        "month": 8.25,
        "why": 10.762
      }
    },
    {
      "id": "tips",
      "file": "tips.mp3",
      "hash": "89ac16708645",
      "durationSec": 27.354,
      "cues": [
        {
          "text": "Vậy các gia đình Việt ở Mỹ xoay xở như thế nào?",
          "start": 0.0,
          "end": 2.75
        },
        {
          "text": "Một: nhờ ông bà hoặc người thân trông trẻ, cắt khoản lớn nhất.",
          "start": 2.75,
          "end": 7.804
        },
        {
          "text": "Hai: sống gần chỗ làm hoặc đi chung xe, để cả nhà chỉ cần một chiếc xe.",
          "start": 7.804,
          "end": 13.333
        },
        {
          "text": "Ba: nấu ăn ở nhà, mua thực phẩm số lượng lớn ở chợ Á Đông hay các cửa hàng bán sỉ.",
          "start": 13.333,
          "end": 19.849
        },
        {
          "text": "Bốn: tận dụng tín dụng thuế trẻ em,",
          "start": 19.849,
          "end": 22.635
        },
        {
          "text": "và tìm hiểu chương trình bảo hiểm y tế cho trẻ",
          "start": 22.635,
          "end": 24.849
        },
        {
          "text": "em của tiểu bang nếu gia đình đủ điều kiện.",
          "start": 24.849,
          "end": 27.349
        }
      ],
      "markers": {
        "t1": 2.75,
        "t2": 7.804,
        "t3": 13.333,
        "t4": 19.849
      }
    },
    {
      "id": "outro",
      "file": "outro.mp3",
      "hash": "cae25d310044",
      "durationSec": 24.943,
      "cues": [
        {
          "text": "Tóm lại, một gia đình bốn người ở Houston cần",
          "start": 0.0,
          "end": 2.768
        },
        {
          "text": "gần 7.000 đô mỗi tháng để sống ở mức cơ bản.",
          "start": 2.768,
          "end": 5.875
        },
        {
          "text": "Ở Quận Cam, gần gấp đôi.",
          "start": 5.875,
          "end": 7.833
        },
        {
          "text": "Đó là lý do ở Mỹ, hầu hết các gia đình có con nhỏ đều cần cả hai vợ chồng cùng đi làm.",
          "start": 7.833,
          "end": 14.107
        },
        {
          "text": "Còn gia đình bạn, mỗi tháng đang chi khoảng bao nhiêu, và khoản nào là lớn nhất?",
          "start": 14.107,
          "end": 19.036
        },
        {
          "text": "Hãy chia sẻ ở phần bình luận.",
          "start": 19.036,
          "end": 21.25
        },
        {
          "text": "Đừng quên đăng ký kênh Tin Nước Mỹ để xem những tập tiếp theo.",
          "start": 21.25,
          "end": 24.929
        }
      ],
      "markers": {
        "oc": 5.875,
        "key": 7.833,
