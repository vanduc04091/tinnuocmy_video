  "rate": "-4%",
  "scenes": [
    {
      "id": "hook",
      "file": "hook.mp3",
      "hash": "12aaf9dc9533",
      "durationSec": 25.728,
      "cues": [
        {
          "text": "Một gia đình bốn người ở Mỹ: hai vợ chồng và hai con nhỏ.",
          "start": 0.0,
          "end": 3.607
        },
        {
          "text": "Mỗi tháng, họ cần bao nhiêu tiền?",
          "start": 3.607,
          "end": 5.571
        },
        {
          "text": "50 triệu?",
          "start": 5.571,
          "end": 7.018
        },
        {
          "text": "100 triệu?",
          "start": 7.018,
          "end": 7.821
        },
        {
          "text": "Hay gần 200 triệu đồng?",
          "start": 7.821,
          "end": 9.786
        },
        {
          "text": "Câu trả lời có thể khiến bạn bất ngờ.",
          "start": 9.786,
          "end": 12.125
        },
        {
          "text": "Chỉ để sống ở mức cơ bản tại Houston, một trong những thành phố dễ thở nhất nước Mỹ,",
          "start": 12.125,
          "end": 17.393
        },
        {
          "text": "gia đình này cần gần 7.000 đô mỗi tháng.",
          "start": 17.393,
          "end": 20.321
        },
        {
          "text": "Hôm nay, Tin Nước Mỹ sẽ đi qua từng khoản, và có một khoản còn đắt hơn cả tiền nhà.",
          "start": 20.321,
          "end": 25.714
        }
      ],
      "markers": {
        "g1": 5.571,
        "g2": 7.018,
        "g3": 7.821,
        "ans": 9.786,
        "plan": 20.321
      }
    },
    {
      "id": "profile",
      "file": "profile.mp3",
      "hash": "e803bf6b9e3b",
      "durationSec": 16.87,
      "cues": [
        {
          "text": "Gia đình của chúng ta: hai vợ chồng đều đi làm toàn thời gian,",
          "start": 0.0,
          "end": 4.054
        },
        {
          "text": "một bé ba tuổi đi nhà trẻ, một bé tám tuổi học trường công, sống ở Houston, Texas.",
          "start": 4.054,
          "end": 10.446
        },
        {
          "text": "Các con số chủ yếu lấy từ bộ tính chi phí sinh hoạt của MIT,",
          "start": 10.446,
          "end": 14.829
        },
        {
          "text": "cùng phương pháp như những tập trước.",
          "start": 14.829,
          "end": 16.857
        }
      ],
      "markers": {
        "p1": 1.232,
        "p2": 4.054,
        "p3": 6.393,
        "p4": 8.4,
        "src": 10.446
      }
    },
    {
      "id": "housing",
      "file": "housing.mp3",
      "hash": "6d32ac741642",
      "durationSec": 12.934,
      "cues": [
        {
          "text": "Khoản đầu tiên: nhà ở.",
          "start": 0.0,
          "end": 1.964
        },
        {
          "text": "Một căn hộ hai phòng ngủ ở Houston,",
          "start": 1.964,
          "end": 4.143
        },
        {
          "text": "gồm điện nước cơ bản, tốn khoảng 1.510 đô mỗi tháng.",
          "start": 4.143,
          "end": 8.167
        },
        {
          "text": "Muốn thuê nhà riêng ba phòng ngủ có sân cho con chơi, con số này sẽ cao hơn đáng kể.",
          "start": 8.167,
          "end": 12.929
        }
      ],
      "markers": {
        "rent": 1.964,
        "more": 8.167
      }
    },
    {
      "id": "childcare",
      "file": "childcare.mp3",
      "hash": "83f055217368",
      "durationSec": 33.009,
      "cues": [
        {
          "text": "Và đây là khoản khiến nhiều phụ huynh mới sang Mỹ choáng váng: tiền giữ trẻ.",
          "start": 0.0,
          "end": 4.732
        },
        {
          "text": "Nhà trẻ cho bé nhỏ và giữ trẻ sau giờ học cho bé lớn tốn khoảng 1.690 đô mỗi tháng.",
          "start": 4.732,
          "end": 11.536
        },
        {
          "text": "Nhiều hơn cả tiền nhà.",
          "start": 11.536,
          "end": 13.214
        },
        {
          "text": "Trên toàn nước Mỹ,",
          "start": 13.214,
          "end": 14.893
        },
        {
          "text": "giá gửi trẻ trung bình năm 2025 là khoảng 13.200 đô một năm cho mỗi bé.",
          "start": 14.893,
          "end": 21.501
        },
        {
          "text": "Ở California, có nơi trên 20.000 đô.",
          "start": 21.501,
          "end": 25.048
        },
        {
          "text": "Đó là lý do nhiều gia đình Việt nhờ ông bà sang giúp trông cháu.",
          "start": 25.048,
          "end": 29.483
        },
        {
          "text": "Một quyết định có thể tiết kiệm phần lớn khoản chi lớn nhất này.",
          "start": 29.483,
          "end": 33.001
        }
      ],
      "markers": {
        "mit": 4.732,
        "vs": 11.536,
        "us": 13.214,
        "ca": 21.501,
        "vn": 25.048
      }
    },
    {
      "id": "food",
      "file": "food.mp3",
      "hash": "bb849df434f3",
      "durationSec": 20.507,
      "cues": [
        {
          "text": "Tiền ăn.",
          "start": 0.0,
          "end": 0.762
        },
        {
          "text": "Bộ Nông nghiệp Mỹ tính rằng một gia đình bốn người,",
          "start": 0.762,
          "end": 4.054
        },
        {
          "text": "nấu ăn ở nhà ở mức tiết kiệm, cần khoảng 1.020 đô mỗi tháng.",
          "start": 4.054,
          "end": 8.589
        },
        {
          "text": "Với giá cả ở Houston, MIT ước tính khoảng 940 đô.",
          "start": 8.589,
          "end": 13.404
        },
        {
          "text": "Trẻ con đang tuổi lớn, thêm vài bữa ăn ngoài cuối tuần hay quà sinh nhật bạn bè,",
          "start": 13.404,
          "end": 18.554
        },
        {
          "text": "con số này rất dễ cao hơn.",
          "start": 18.554,
          "end": 20.5
        }
      ],
      "markers": {
        "usda": 0.762,
        "mit": 8.589,
        "real": 13.404
      }
    },
    {
      "id": "health",
      "file": "health.mp3",
      "hash": "23d280be42a8",
      "durationSec": 22.0,
      "cues": [
        {
          "text": "Bảo hiểm sức khỏe cho cả nhà.",
          "start": 0.0,
          "end": 1.557
        },
        {
          "text": "Theo khảo sát của tổ chức KFF năm 2025,",
          "start": 1.557,
          "end": 5.464
        },
        {
          "text": "gói bảo hiểm gia đình qua công ty có giá trung bình khoảng 27.000 đô một năm.",
          "start": 5.464,
          "end": 9.8
        },
        {
          "text": "Công ty trả phần lớn, nhưng người lao động vẫn tự đóng khoảng 570 đô mỗi tháng.",
          "start": 9.8,
          "end": 15.0
        },
        {
          "text": "Cộng thêm tiền khám, thuốc và nha khoa cho hai đứa trẻ,",
          "start": 15.0,
          "end": 19.0
        },
        {
          "text": "MIT ước tính khoảng 920 đô mỗi tháng.",
          "start": 19.0,
          "end": 22.0
        }
      ],
      "markers": {
        "kff": 1.557,
        "share": 9.8,
        "mit": 15.0
      }
    },
    {
      "id": "transport",
      "file": "transport.mp3",
      "hash": "41802c3f77a1",
      "durationSec": 17.795,
      "cues": [
        {
          "text": "Đi lại.",
          "start": 0.0,
          "end": 0.929
        },
        {
          "text": "Ở Houston, hai vợ chồng cùng đi làm gần như cần hai chiếc xe.",
          "start": 0.929,
          "end": 4.929
        },
        {
          "text": "Xăng, bảo hiểm và bảo dưỡng cho hai xe: khoảng 1.240 đô mỗi tháng.",
          "start": 4.929,
          "end": 10.524
        },
        {
          "text": "Cuối cùng là internet, điện thoại, quần áo,",
          "start": 10.524,
          "end": 13.833
        },
        {
          "text": "đồ dùng học tập và hoạt động cho con: khoảng 680 đô.",
          "start": 13.833,
          "end": 17.786
        }
      ],
      "markers": {
        "cars": 0.929,
        "cost": 4.929,
        "other": 10.524
      }
    },
    {
      "id": "total",
      "file": "total.mp3",
      "hash": "d34da14fb683",
      "durationSec": 53.515,
      "cues": [
        {
          "text": "Giờ hãy cộng lại.",
          "start": 0.0,
          "end": 1.339
        },
        {
          "text": "Nhà ở 1.510.",
          "start": 1.339,
          "end": 4.714
        },
        {
          "text": "Giữ trẻ 1.690.",
          "start": 4.714,
          "end": 8.349
        },
        {
          "text": "Ăn uống 940.",
          "start": 8.349,
          "end": 10.769
        },
        {
          "text": "Sức khỏe 920.",
          "start": 10.769,
          "end": 13.903
        },
        {
          "text": "Đi lại 1.240.",
          "start": 13.903,
          "end": 17.117
        },
        {
          "text": "Các khoản khác 680.",
          "start": 17.117,
          "end": 20.581
        },
        {
          "text": "Tổng cộng gần 7.000 đô mỗi tháng, tương đương hơn 180 triệu đồng.",
          "start": 20.581,
          "end": 26.914
        },
        {
          "text": "Để có số tiền này sau thuế, theo MIT,",
          "start": 26.914,
          "end": 30.688
        },
        {
          "text": "hai vợ chồng cần tổng thu nhập khoảng 102.000 đô một năm.",
          "start": 30.688,
          "end": 34.771
        },
        {
          "text": "Trong khi thu nhập trung vị của một hộ gia đình ở Texas chỉ khoảng 77.500 đô.",
          "start": 34.771,
          "end": 41.421
        },
        {
          "text": "May mắn là có hỗ trợ: tín dụng thuế trẻ em năm 2026 tối đa 2.200 đô mỗi con,",
          "start": 41.421,
          "end": 50.135
        },
        {
          "text": "tức khoảng 370 đô mỗi tháng cho hai con.",
          "start": 50.135,
          "end": 53.51
        }
      ],
      "markers": {
        "l1": 1.339,
