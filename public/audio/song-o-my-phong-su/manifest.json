    {
      "id": "states",
      "file": "states.mp3",
      "hash": "0ed407294ad7",
      "durationSec": 74.057,
      "cues": [
        {
          "text": "Vậy có phải sống ở Mỹ nơi nào cũng đắt đỏ như nhau?",
          "start": 0.0,
          "end": 3.64
        },
        {
          "text": "Câu trả lời là không.",
          "start": 3.64,
          "end": 5.3
        },
        {
          "text": "Chi phí nhà ở, thuế,",
          "start": 5.3,
          "end": 7.413
        },
        {
          "text": "đi lại và các dịch vụ thiết yếu có thể khác nhau đáng kể giữa các bang,",
          "start": 7.413,
          "end": 12.272
        },
        {
          "text": "thậm chí giữa các thành phố trong cùng một bang.",
          "start": 12.272,
          "end": 15.08
        },
        {
          "text": "Hãy thử đặt cùng người đó vào Quận Cam, California.",
          "start": 15.08,
          "end": 19.2
        },
        {
          "text": "Giá thuê chuẩn do chính phủ Mỹ công bố cho căn một phòng ngủ ở đây là khoảng 2.750 đô,",
          "start": 19.2,
          "end": 26.72
        },
        {
          "text": "hơn gấp đôi Houston.",
          "start": 26.72,
          "end": 28.592
        },
        {
          "text": "Cộng các khoản khác, tổng chi phí lên tới khoảng 4.600 đô một tháng,",
          "start": 28.592,
          "end": 34.08
        },
        {
          "text": "tức hơn 100 triệu đồng.",
          "start": 34.08,
          "end": 36.34
        },
        {
          "text": "Mức thu nhập cần có theo MIT là khoảng 36 đô một giờ, so với 22 đô ở Houston.",
          "start": 36.34,
          "end": 45.177
        },
        {
          "text": "Thuế cũng khác: Texas không thu thuế thu nhập tiểu bang,",
          "start": 45.177,
          "end": 49.977
        },
        {
          "text": "còn California thu từ một đến hơn mười ba phần trăm.",
          "start": 49.977,
          "end": 54.19
        },
        {
          "text": "Nhưng một nơi có chi phí thấp hơn chưa chắc đã giúp bạn tiết kiệm hơn,",
          "start": 54.19,
          "end": 59.917
        },
        {
          "text": "nếu cơ hội việc làm hạn chế, mức lương thấp hơn,",
          "start": 59.917,
          "end": 63.209
        },
        {
          "text": "hoặc phải di chuyển quãng đường dài mỗi ngày.",
          "start": 63.209,
          "end": 66.244
        },
        {
          "text": "Vì vậy, bạn nên so sánh tổng chi phí sinh hoạt với thu nhập,",
          "start": 66.244,
          "end": 71.209
        },
        {
          "text": "thay vì chỉ dựa vào một khoản chi riêng lẻ.",
          "start": 71.209,
          "end": 74.057
        }
      ],
