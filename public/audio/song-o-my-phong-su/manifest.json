    {
      "id": "outro",
      "file": "outro.mp3",
      "hash": "8dd1af8fe4a7",
      "durationSec": 48.64,
      "cues": [
        {
          "text": "Như vậy, để biết sống ở Mỹ tốn bao nhiêu tiền mỗi tháng,",
          "start": 0.0,
          "end": 3.867
        },
        {
          "text": "chúng ta cần xem xét ít nhất năm yếu tố:",
          "start": 3.867,
          "end": 6.352
        },
        {
          "text": "tiền nhà, ăn uống, đi lại, bảo hiểm và chi tiêu cá nhân.",
          "start": 6.352,
          "end": 11.293
        },
        {
          "text": "Không có một con số phù hợp cho tất cả mọi người:",
          "start": 11.293,
          "end": 14.84
        },
        {
          "text": "một người độc thân ở Houston cần khoảng 3.000 đô,",
          "start": 14.84,
          "end": 18.84
        },
        {
          "text": "ở Quận Cam khoảng 4.600 đô, và một gia đình có con nhỏ sẽ cần nhiều hơn thế.",
          "start": 18.84,
          "end": 25.248
        },
        {
          "text": "Điều quan trọng nhất là so sánh thu nhập thực nhận",
          "start": 25.248,
          "end": 28.68
        },
        {
          "text": "với chi phí sinh hoạt tại chính nơi bạn dự định sống.",
          "start": 28.68,
          "end": 32.176
        },
        {
          "text": "Theo bạn, một gia đình Việt Nam sống tại Mỹ cần tối thiểu bao nhiêu tiền mỗi tháng?",
          "start": 32.176,
          "end": 37.74
        },
        {
          "text": "Hãy chia sẻ ý kiến của bạn ở phần bình luận.",
          "start": 37.74,
          "end": 41.16
        },
        {
          "text": "Đừng quên đăng ký kênh để cùng tìm hiểu thêm những câu chuyện thực tế về cuộc sống,",
          "start": 41.16,
          "end": 45.96
        },
        {
          "text": "thu nhập và chi phí sinh hoạt tại Mỹ.",
          "start": 45.96,
          "end": 48.64
        }
      ],
