      "cues": [
        {
          "text": "Còn với du học sinh, bức tranh khác hẳn.",
          "start": 0.0,
          "end": 2.68
        },
        {
          "text": "Nếu ở ghép với bạn, đi xe buýt hoặc đi chung xe, và dùng bảo hiểm của trường,",
          "start": 2.68,
          "end": 8.6
        },
        {
