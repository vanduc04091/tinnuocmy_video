      }
    },
    {
      "id": "total",
      "file": "total.mp3",
      "hash": "7bdd57fae7be",
      "durationSec": 37.94,
      "cues": [
        {
          "text": "Giờ hãy cộng tất cả lại.",
          "start": 0.0,
          "end": 1.8
        },
        {
          "text": "Nhà ở và điện nước 1.270.",
          "start": 1.8,
          "end": 5.941
        },
        {
          "text": "Ăn uống 325.",
          "start": 5.941,
          "end": 8.301
        },
        {
          "text": "Đi lại 740.",
          "start": 8.301,
          "end": 10.661
        },
        {
          "text": "Sức khỏe 270.",
          "start": 10.661,
          "end": 12.848
        },
        {
          "text": "Internet và điện thoại 135.",
          "start": 12.848,
          "end": 17.061
        },
        {
          "text": "Chi tiêu cá nhân 250.",
          "start": 17.061,
          "end": 19.765
        },
        {
          "text": "Tổng cộng: khoảng 3.000 đô một tháng, tương đương gần 80 triệu đồng.",
          "start": 19.765,
          "end": 25.509
        },
        {
          "text": "Theo MIT, để trang trải mức sống cơ bản này,",
          "start": 25.509,
          "end": 30.301
        },
        {
          "text": "một người ở Houston cần thu nhập khoảng 22 đô một giờ,",
          "start": 30.301,
          "end": 34.401
        },
        {
          "text": "tức khoảng 46.000 đô một năm trước thuế.",
          "start": 34.401,
          "end": 37.941
        }
      ],
