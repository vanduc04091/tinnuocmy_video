      }
    },
    {
      "id": "housing",
      "file": "housing.mp3",
      "hash": "562e896e2467",
      "durationSec": 49.68,
      "cues": [
        {
          "text": "Khoản chi tiêu đầu tiên, và thường là lớn nhất tại Mỹ, chính là tiền nhà.",
          "start": 0.0,
          "end": 4.62
        },
        {
          "text": "Chi phí thuê nhà phụ thuộc rất nhiều vào nơi bạn sinh sống.",
          "start": 4.62,
          "end": 8.28
        },
        {
          "text": "Ở Houston, giá thuê trung vị một căn hộ một phòng ngủ trên các trang",
          "start": 8.28,
          "end": 12.62
        },
        {
          "text": "cho thuê năm 2026 dao động khoảng 1.050 đến 1.300 đô mỗi tháng.",
          "start": 12.62,
          "end": 19.547
        },
        {
          "text": "Ngoài tiền thuê nhà, bạn còn có thể phải trả tiền điện,",
          "start": 19.547,
          "end": 23.664
        },
        {
          "text": "nước, internet, chỗ đậu xe và bảo hiểm người thuê nhà.",
          "start": 23.664,
          "end": 27.664
        },
        {
          "text": "Theo MIT, tiền nhà cộng điện nước cơ bản cho một",
          "start": 27.664,
          "end": 31.96
        },
        {
          "text": "người ở Houston vào khoảng 1.270 đô một tháng.",
          "start": 31.96,
          "end": 36.293
        },
        {
          "text": "Vì vậy, khi tìm hiểu cuộc sống ở Mỹ, bạn không nên chỉ hỏi một câu là lương bao nhiêu.",
          "start": 36.293,
          "end": 42.656
        },
        {
          "text": "Điều quan trọng hơn là sau khi trả tiền nhà và các chi phí thiết yếu,",
          "start": 42.656,
          "end": 47.66
        },
        {
          "text": "bạn còn lại bao nhiêu tiền để sinh hoạt.",
          "start": 47.66,
          "end": 49.68
        }
      ],
      "markers": {
        "loc": 4.62,
