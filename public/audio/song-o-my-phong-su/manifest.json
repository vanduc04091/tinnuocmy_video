    {
      "id": "health",
      "file": "health.mp3",
      "hash": "8f675af3e841",
      "durationSec": 44.08,
      "cues": [
        {
          "text": "Một khoản mà người mới sang Mỹ cần đặc biệt lưu ý là bảo hiểm sức khỏe.",
          "start": 0.0,
          "end": 4.533
        },
        {
          "text": "Ngay cả khi có bảo hiểm, bạn vẫn phải trả phí bảo hiểm hằng tháng,",
          "start": 4.533,
          "end": 9.32
        },
        {
          "text": "khoản khấu trừ trước khi bảo hiểm chi trả, và một phần chi phí mỗi lần khám chữa bệnh.",
          "start": 9.32,
          "end": 15.04
        },
        {
          "text": "Nếu đi làm toàn thời gian, công ty thường đóng phần lớn phí bảo hiểm.",
          "start": 15.04,
          "end": 19.32
        },
        {
          "text": "Còn nếu tự mua trên sàn bảo hiểm của chính phủ,",
          "start": 19.32,
          "end": 22.3
        },
        {
          "text": "phí trung bình năm 2026 cho một người bốn mươi tuổi ở Texas là 661 đô mỗi tháng,",
          "start": 22.3,
          "end": 30.52
        },
        {
          "text": "trước khi được trợ cấp.",
          "start": 30.52,
          "end": 32.3
        },
        {
          "text": "Trong bảng tính, chúng ta dùng ước tính của MIT cho người có bảo hiểm qua công ty:",
          "start": 32.3,
          "end": 38.126
        },
        {
          "text": "khoảng 270 đô mỗi tháng, gồm cả phí bảo hiểm và tiền khám chữa bệnh tự trả.",
          "start": 38.126,
          "end": 44.08
        }
      ],
      "markers": {
        "even": 4.533,
        "h1": 7.52,
        "h2": 9.32,
        "h3": 12.2,
        "job": 15.04,
