    {
      "id": "food",
      "file": "food.mp3",
      "hash": "b834c494055f",
      "durationSec": 43.36,
      "cues": [
        {
          "text": "Khoản chi tiếp theo là ăn uống.",
          "start": 0.0,
          "end": 2.24
        },
        {
          "text": "Nhiều người nghĩ rằng đi siêu thị ở Mỹ sẽ rất đắt đỏ.",
          "start": 2.24,
          "end": 5.653
        },
        {
          "text": "Nhưng thực tế, số tiền bạn chi phụ thuộc vào thói quen mua sắm,",
          "start": 5.653,
          "end": 10.352
        },
        {
          "text": "loại thực phẩm và số người trong gia đình.",
          "start": 10.352,
          "end": 13.0
        },
        {
          "text": "Với một người chủ yếu tự nấu ăn,",
          "start": 13.0,
          "end": 15.813
        },
        {
          "text": "MIT ước tính tiền thực phẩm ở Houston khoảng 325 đô một tháng.",
          "start": 15.813,
          "end": 20.7
        },
        {
          "text": "Nếu thường xuyên ăn nhà hàng hoặc đặt đồ ăn, con số này sẽ cao hơn nhiều.",
          "start": 20.7,
          "end": 26.093
        },
        {
          "text": "Những khoản tưởng chừng nhỏ như cà phê,",
          "start": 26.093,
          "end": 29.653
        },
        {
          "text": "đồ uống và đồ ăn nhanh cũng có thể cộng lại thành một khoản đáng kể vào cuối tháng.",
          "start": 29.653,
          "end": 34.94
        },
        {
          "text": "Một lợi thế ở Houston: khu Bellaire có rất nhiều chợ và quán Việt,",
          "start": 34.94,
          "end": 40.688
        },
        {
          "text": "giúp bạn mua đồ quen thuộc với giá dễ chịu hơn.",
          "start": 40.688,
          "end": 43.36
        }
      ],
      "markers": {
        "think": 2.24,
        "real": 5.653,
