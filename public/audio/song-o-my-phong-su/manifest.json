  "scenes": [
    {
      "id": "intro",
      "file": "intro.mp3",
      "hash": "ffdb2c4a2c8f",
      "durationSec": 27.04,
      "cues": [
        {
          "text": "Một tháng sống ở Mỹ tốn bao nhiêu tiền?",
          "start": 0.0,
          "end": 2.347
        },
        {
          "text": "30 triệu đồng, 50 triệu đồng, hay thậm chí hơn 100 triệu đồng?",
          "start": 2.347,
          "end": 7.174
        },
        {
          "text": "Có người cho rằng chỉ cần có công việc ổn định là có thể sống thoải mái tại Mỹ.",
          "start": 7.174,
          "end": 12.294
        },
        {
          "text": "Nhưng cũng có người đi làm cả tháng,",
          "start": 12.294,
          "end": 14.849
        },
        {
          "text": "nhận lương xong đã phải dành phần lớn số tiền đó để trả tiền nhà,",
          "start": 14.849,
          "end": 18.833
        },
        {
          "text": "tiền xe, bảo hiểm và thực phẩm.",
          "start": 18.833,
          "end": 21.201
        },
        {
          "text": "Vậy thực tế, nếu một người Việt sang Mỹ sinh sống,",
          "start": 21.201,
          "end": 25.101
        },
        {
          "text": "mỗi tháng cần chuẩn bị bao nhiêu tiền?",
          "start": 25.101,
          "end": 27.041
        }
      ],
      "markers": {
        "n30": 2.347,
        "n50": 3.94,
        "n100": 5.761,
        "p1": 7.174,
        "p2": 12.294,
        "b1": 17.969,
        "b2": 18.833,
        "b3": 19.661,
        "b4": 20.449,
        "q": 21.201
      }
    },
    {
      "id": "profile",
      "file": "profile.mp3",
      "hash": "cc3f5eaf56f6",
      "durationSec": 31.12,
      "cues": [
        {
          "text": "Để có câu trả lời cụ thể thay vì nói chung chung,",
          "start": 0.0,
          "end": 3.08
        },
        {
          "text": "chúng ta sẽ lấy một ví dụ: một người độc thân, thuê một căn hộ nhỏ,",
          "start": 3.08,
          "end": 7.973
        },
        {
          "text": "có xe hơi để đi làm, sống ở Houston, Texas,",
          "start": 7.973,
          "end": 11.82
        },
        {
          "text": "nơi có một trong những cộng đồng người Việt đông nhất nước Mỹ.",
          "start": 11.82,
          "end": 14.78
        },
        {
          "text": "Các con số chủ yếu lấy từ bộ tính chi phí sinh",
          "start": 14.78,
          "end": 18.048
        },
        {
          "text": "hoạt của Học viện Công nghệ Massachusetts,",
          "start": 18.048,
          "end": 20.688
        },
        {
          "text": "viết tắt là MIT, cho cùng một khu vực.",
          "start": 20.688,
          "end": 24.053
        },
        {
          "text": "Cuối video, chúng ta sẽ so sánh với Quận Cam,",
          "start": 24.053,
          "end": 27.673
        },
        {
          "text": "California, nơi có khu Little Saigon nổi tiếng.",
          "start": 27.673,
          "end": 31.12
        }
      ],
      "markers": {
        "who": 4.84,
        "home": 6.688,
        "car": 7.973,
        "city": 9.632,
