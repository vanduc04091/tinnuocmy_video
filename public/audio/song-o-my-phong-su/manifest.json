    {
      "id": "transport",
      "file": "transport.mp3",
      "hash": "88caad68505a",
      "durationSec": 44.48,
      "cues": [
        {
          "text": "Ở nhiều khu vực của Mỹ, và đặc biệt là Houston, ô tô gần như là thứ bắt buộc.",
          "start": 0.0,
          "end": 5.107
        },
        {
          "text": "Nhưng sở hữu một chiếc xe không chỉ có tiền mua xe.",
          "start": 5.107,
          "end": 8.94
        },
        {
          "text": "Bạn còn phải tính đến xăng, bảo hiểm, bảo dưỡng và sửa chữa.",
          "start": 8.94,
          "end": 13.712
        },
        {
          "text": "Theo Hiệp hội Ô tô Mỹ,",
          "start": 13.712,
          "end": 15.952
        },
        {
          "text": "tổng chi phí nuôi một chiếc xe mới trung bình gần 965 đô mỗi tháng.",
          "start": 15.952,
          "end": 21.24
        },
        {
          "text": "Còn theo MIT, chi phí đi lại thực tế của một",
          "start": 21.24,
          "end": 24.92
        },
        {
          "text": "người ở Houston vào khoảng 740 đô một tháng.",
          "start": 24.92,
          "end": 29.16
        },
        {
          "text": "Ở những thành phố có giao thông công cộng thuận tiện như New York,",
          "start": 29.16,
          "end": 33.42
        },
        {
          "text": "bạn có thể không cần xe.",
          "start": 33.42,
          "end": 34.96
        },
        {
          "text": "Nhưng tại Houston và nhiều vùng ngoại ô, không có xe riêng sẽ khiến việc đi làm,",
          "start": 34.96,
          "end": 40.82
        },
        {
          "text": "mua sắm và đưa đón con cái khó khăn hơn rất nhiều.",
          "start": 40.82,
          "end": 44.48
        }
      ],
      "markers": {
