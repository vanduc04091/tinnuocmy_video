      "hash": "3686b3b57ecb",
      "durationSec": 15.2,
      "cues": [
        {
          "text": "Cuối cùng là internet, điện thoại,",
          "start": 0.0,
          "end": 2.267
        },
        {
          "text": "và các khoản chi tiêu cá nhân như quần áo, cắt tóc, giải trí.",
          "start": 2.267,
          "end": 6.267
        },
        {
          "text": "Chúng ta tính khoảng 135 đô cho internet và điện thoại,",
          "start": 6.267,
          "end": 10.848
        },
        {
          "text": "cộng thêm 250 đô cho chi tiêu cá nhân ở mức tiết chế.",
          "start": 10.848,
          "end": 15.2
        }
      ],
      "markers": {
